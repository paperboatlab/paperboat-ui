{
  "name": "@paperboatlab/ui",
  "version": "0.1.0",
  "description": "The Paperboat look as React components: tokens, keys, pills, the spinner, the rail, panels, dialogs, menus, toasts, the theme picker, the floating search, app marks, and the node canvas (React Flow): wire routing, layout, ports, snapping, undo. No app logic.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperboatlab/paperboat-ui.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./ui.css": "./src/ui.css",
    "./fonts/*": "./src/fonts/*",
    "./marks/*": "./src/marks/*",
    "./canvas": {
      "types": "./src/canvas/index.ts",
      "default": "./src/canvas/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./files": {
      "types": "./src/files/index.ts",
      "default": "./src/files/index.ts"
    },
    "./graph": {
      "types": "./src/graph/index.ts",
      "default": "./src/graph/index.ts"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "default": "./src/media/index.ts"
    },
    "./plot": {
      "types": "./src/plot/index.ts",
      "default": "./src/plot/index.ts"
    },
    "./scope": {
      "types": "./src/scope/index.ts",
      "default": "./src/scope/index.ts"
    },
    "./packages": {
      "types": "./src/packages/index.ts",
      "default": "./src/packages/index.ts"
    },
    "./hub": {
      "types": "./src/hub/index.ts",
      "default": "./src/hub/index.ts"
    },
    "./stage": {
      "types": "./src/stage/index.ts",
      "default": "./src/stage/index.ts"
    },
    "./workspace": {
      "types": "./src/workspace/index.ts",
      "default": "./src/workspace/index.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/canvas/*.test.ts test/editor/*.test.ts test/plot/*.test.ts test/stage/*.test.ts",
    "icons": "python3 scripts/icons.py ${REBRAND:-../../../Cloud/gdrive/Projects/paperboatlab/agent-docs/rebrand}",
    "demo": "esbuild demo/demo.tsx demo/parts.tsx demo/hub.tsx --bundle --format=esm --outdir=demo/out --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --jsx=automatic --log-level=warning && cp -r src/marks demo/out/"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/funnel-display": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/three": "^0.187.0",
    "katex": "^0.19.1",
    "smol-toml": "^1.9.1",
    "three": "^0.187.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.1",
    "esbuild": "^0.25.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
