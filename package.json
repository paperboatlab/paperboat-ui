{
  "name": "@paperboatlab/ui",
  "version": "0.1.0",
  "description": "The Paperboat look as React components: tokens, keys, pills, the spinner, the rail, panels, dialogs, menus, toasts, the theme picker, the floating search, app marks. No app logic.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperboatlab/paperboat-ui.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./ui.css": "./src/ui.css",
    "./fonts/*": "./src/fonts/*",
    "./marks/*": "./src/marks/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "icons": "python3 scripts/icons.py ${REBRAND:-../../../Cloud/gdrive/Projects/paperboatlab/agent-docs/rebrand}",
    "demo": "esbuild demo/demo.tsx --bundle --format=esm --outdir=demo/out --loader:.woff2=file --loader:.woff=file --jsx=automatic --log-level=warning && cp -r src/marks demo/out/"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource/funnel-display": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "esbuild": "^0.25.0"
  }
}
